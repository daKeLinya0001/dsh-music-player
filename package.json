{
  "name": "@dakelinya0001/dsh-music-player",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local music player for DSH with audio-reactive spectrum bars and customizable shortcuts.",
  "license": "MIT",
  "author": "daKeLinya0001",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daKeLinya0001/dsh-music-player.git"
  },
  "homepage": "https://github.com/daKeLinya0001/dsh-music-player#readme",
  "bugs": {
    "url": "https://github.com/daKeLinya0001/dsh-music-player/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "music-player",
    "web-audio",
    "visualizer"
  ],
  "scripts": {
    "check": "node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
